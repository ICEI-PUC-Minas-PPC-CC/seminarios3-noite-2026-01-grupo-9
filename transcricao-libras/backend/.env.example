# ── Variáveis de ambiente para desenvolvimento local ──
# Copie este arquivo para .env e ajuste conforme necessário.
# NUNCA commite o arquivo .env real no repositório.

# Banco de dados (SQLite para dev local)
DATABASE_URL=sqlite:///./transcricoes.db

# Para PostgreSQL em homologação, use:
# DATABASE_URL=postgresql://usuario_mock:senha_mock_123@localhost:5432/libras_dev

# Modo debug (mostra SQL no console)
DEBUG=true

# Origens CORS permitidas (separadas por vírgula no .env não funciona;
# defina diretamente no config.py ou use JSON)
